@startuml

title Catálogo de Medicamentos\nDiagrama de Casos de Uso

left to right direction

actor Administrador
actor Médico
actor Enfermera

rectangle "Catálogo de Medicamentos" {
    usecase "Dar de alta\nmedicamento" as UC1
    usecase "Buscar medicamento" as UC2
    usecase "Consultar medicamento" as UC3
    usecase "Controlar vigencia\nactivar o desactivar" as UC4

    usecase "Validar datos" as UC5
    usecase "Comprobar duplicado" as UC6
    usecase "Validar hospital activo" as UC7
}

Administrador --> UC1
Administrador --> UC2
Administrador --> UC3
Administrador --> UC4

Médico --> UC2
Médico --> UC3

Enfermera --> UC2
Enfermera --> UC3

UC1 .> UC5 : <<include>>
UC1 .> UC6 : <<include>>
UC1 .> UC7 : <<include>>

UC2 .> UC7 : <<include>>
UC3 .> UC7 : <<include>>
UC4 .> UC7 : <<include>>

note right of UC4
El medicamento no se elimina.
Se cambia su estado mediante
el campo active.
end note

@enduml